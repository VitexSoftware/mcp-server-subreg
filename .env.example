# Subreg SOAP credentials (never commit a real .env)
# Production:
SUBREG_LOCATION=https://soap.subreg.cz/cmd.php
SUBREG_URI=https://soap.subreg.cz/soap
# OTE sandbox (preferred for write tests):
# SUBREG_LOCATION=https://ote-soap.subreg.cz/cmd.php
# SUBREG_URI=https://ote-soap.subreg.cz/soap

SUBREG_LOGIN=your-login
SUBREG_PASSWORD=your-password

# Block domain/DNS/contact/billing mutations (default if unset)
SUBREG_READONLY=true
